import java.util.*;

public class Main {

    static int ceilDiv(int a, int b) {
        return (a + b - 1) / b;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int x = sc.nextInt();
            int y = sc.nextInt();
            int z = sc.nextInt();

            // Option 1: Nikita does not use AI
            int ans = ceilDiv(n, x + y);

            // Option 2: Nikita uses AI
            if (z * x < n) {
                ans = Math.min(ans,
                        z + ceilDiv(n - z * x, x + 10 * y));
            }

            System.out.println(ans);
        }
    }
}
